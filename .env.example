# Database (VIP MariaDB service)
VIP_MARIADB_USER=
VIP_MARIADB_PASSWORD=
VIP_MARIADB_NAME=
VIP_MARIADB_WRITE_HOSTS=127.0.0.1:3306

# HTTP Basic Auth (optional — omit AUTH_PASSWORD to disable in dev)
AUTH_USER=admin
AUTH_PASSWORD=

# Production CORS origin
ALLOWED_ORIGIN=https://your-vip-app.go-vip.net

# Path-scoped access control (see docs/adr/0001-app-level-access-control.md)
# ALLOWED_IPS: comma-separated IPs/CIDRs allowed to reach non-API (UI) routes
# in production. This is a SEED/PLACEHOLDER list — replace with the real list
# before relying on it, and before disabling the VIP Dashboard IP Allow List.
ALLOWED_IPS=
# AUTOMATTIC_NETWORK_CIDRS: comma-separated CIDR ranges for Automattic-internal
# traffic, always admitted by the UI gate (and the API gate's dual-path check)
# regardless of ALLOWED_IPS. Starts empty — no Node-equivalent of PHP's
# is_proxied_request() is documented by VIP; populate from VIP Support/TAM
# before disabling the Dashboard IP Allow List's Automattic exception.
AUTOMATTIC_NETWORK_CIDRS=
# SCANNER_API_TOKEN: shared-secret bearer token required on /api/v1/* for
# callers outside ALLOWED_IPS/AUTOMATTIC_NETWORK_CIDRS. Generate with e.g.
# `openssl rand -hex 32`. Never commit a real value.
SCANNER_API_TOKEN=

# Server port (injected automatically by VIP hosting)
PORT=3001

# GSA Site Scanner API key (optional, for live data refresh)
GSA_API_KEY=

# Anthropic Claude — powers the in-app chat over the site data.
# Can also be set from the Settings page (stored in the DB settings table).
ANTHROPIC_API_KEY=
# Model used for chat. Version-pinned IDs only (no "-latest" alias).
# Default is Claude Sonnet 4.6; the Settings dropdown lists whatever the key
# can access via the Models API.
ANTHROPIC_MODEL=claude-sonnet-4-6
