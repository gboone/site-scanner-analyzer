# Database (VIP MariaDB service)
VIP_MARIADB_USER=
VIP_MARIADB_PASSWORD=
VIP_MARIADB_NAME=
VIP_MARIADB_WRITE_HOSTS=127.0.0.1:3306

# HTTP Basic Auth (optional — omit AUTH_PASSWORD to disable in dev)
AUTH_USER=admin
AUTH_PASSWORD=

# Production CORS origin
ALLOWED_ORIGIN=https://your-vip-app.go-vip.net

# Server port (injected automatically by VIP hosting)
PORT=3001

# GSA Site Scanner API key (optional, for live data refresh)
GSA_API_KEY=

# Anthropic Claude — powers the in-app chat over the site data.
# Can also be set from the Settings page (stored in the DB settings table).
ANTHROPIC_API_KEY=
# Model used for chat. Version-pinned IDs only (no "-latest" alias).
# Default is Claude Sonnet 4.6; the Settings dropdown lists whatever the key
# can access via the Models API.
ANTHROPIC_MODEL=claude-sonnet-4-6
